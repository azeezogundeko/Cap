# Paste into Dokploy -> your Compose service -> Environment.
# Generate secrets with: openssl rand -hex 32

# ---- Required ----
CAP_URL=https://cap.example.com
S3_PUBLIC_URL=https://s3.example.com

DATABASE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=
MEDIA_SERVER_WEBHOOK_SECRET=

MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

MINIO_ROOT_USER=capadmin
MINIO_ROOT_PASSWORD=

# ---- Optional ----
# Pin a release instead of "latest" for reproducible deploys
CAP_IMAGE_TAG=latest
S3_BUCKET=cap

# Comma-separated list, e.g. example.com. Empty = anyone can sign up.
CAP_ALLOWED_SIGNUP_DOMAINS=

# Email login links (without these, links are printed in the cap-web logs)
RESEND_API_KEY=
RESEND_FROM_DOMAIN=

# Transcription / AI
ASSEMBLY_API_KEY=
ASSEMBLY_BASE_URL=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
